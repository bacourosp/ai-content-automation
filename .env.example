APP_NAME=x_ai_content_automation
ENVIRONMENT=local

# ===== LLM =====
# Proveedor por defecto: "gemini" (gratis, JSON fiable) o "nvidia"
LLM_PROVIDER=gemini

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 desactiva el "thinking" (gemini-2.5-* razona y consume el presupuesto de tokens,
# truncando el JSON del content_plan). Déjalo en 0 para el scoring.
GEMINI_THINKING_BUDGET=0

# NVIDIA NIM (DeepSeek) - alternativa: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=deepseek-ai/deepseek-v3.1-terminus

# ===== X / Twitter =====
# Bearer token v2: https://developer.x.com
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_SOURCES=search
X_ACCOUNTS=
X_LIST_ID=
X_INCLUDE_KEYWORDS=ai,artificial intelligence,openai,anthropic,deepseek,llm,genai,model,benchmark,agent,rag,vision,multimodal
X_EXCLUDE_KEYWORDS=giveaway,airdrop,crypto,nft,casino,betting,adult
X_LANGUAGE_HINT=en,es

# ===== RENDER PROVIDERS (generación de video, seleccionable) =====
# higgsfield (default) | mcp (HTTP genérico) | glif | remotion_media | remotion_app
RENDER_PROVIDER=higgsfield
# Costes genéricos para proveedores != higgsfield (0 = sin límite)
RENDER_COST_PER_VIDEO_USD=0
RENDER_FREE_TIER_MONTHLY_USD=0
RENDER_FREE_TIER_MONTHLY_VIDEOS=0
# Imágenes para carruseles/thumbnails con la API OFICIAL de Gemini (off por defecto)
ENABLE_IMAGE_GEN=false
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# -- Higgsfield (MCP por HTTP) --
HIGGSFIELD_MCP_URL=
HIGGSFIELD_API_KEY=
HIGGSFIELD_TIMEOUT_SECONDS=900
# Deja vacío para autodescubrir el tool; o fija el nombre exacto del tool MCP.
HIGGSFIELD_TOOL_NAME=
# Nombre del argumento que espera el tool MCP (autodetecta por inputSchema si puede).
HIGGSFIELD_ARG_NAME=video_spec
# Control de capa gratuita (0 = deshabilitado)
HIGGSFIELD_COST_PER_VIDEO_USD=0
HIGGSFIELD_FREE_TIER_MONTHLY_USD=0
HIGGSFIELD_FREE_TIER_MONTHLY_VIDEOS=0

# -- mcp (genérico HTTP): apunta a CUALQUIER servidor MCP de render por HTTP --
RENDER_MCP_URL=
RENDER_API_KEY=
RENDER_TOOL_NAME=
RENDER_ARG_NAME=
RENDER_INPUT_KIND=spec

# -- glif (oficial glif.app, vía stdio). Seguridad: SOLO se ejecuta el glif id fijo de abajo. --
GLIF_API_TOKEN=
GLIF_RENDER_ID=
GLIF_TOOL_NAME=run_glif
GLIF_MCP_COMMAND=npx -y @glifxyz/glif-mcp-server@0.9.9

# -- remotion_media (stephengpope, vía stdio → kie.ai). Genera video/audio reales. --
KIE_API_KEY=
REMOTION_MEDIA_MCP_COMMAND=npx -y remotion-media-mcp@1.2.2

# -- remotion_app (mcp-use, HTTP). AVISO: ejecuta código React generado por IA (ACE). SOLO self-host. --
REMOTION_APP_MCP_URL=

# ===== TikTok (Content Posting API) =====
# Se rellenan solos al conectar via /oauth/tiktok/start
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_SCOPES=video.publish,video.upload

# ===== Meta (Instagram + Facebook Graph API) =====
# META_ACCESS_TOKEN / FACEBOOK_PAGE_ID / INSTAGRAM_BUSINESS_ACCOUNT_ID
# se rellenan solos al conectar via /oauth/meta/start
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
META_GRAPH_API_VERSION=v19.0
META_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement,pages_manage_posts,business_management

# ===== Servidor de assets / URL pública =====
PUBLIC_BASE_URL=http://localhost:8088
ASSET_SERVER_PORT=8088
WEBHOOK_PORT=8088
# Cloudflare tunnel (efímero: sin token -> URL trycloudflare que cambia en cada reinicio)
ENABLE_CLOUDFLARE_TUNNEL=false
CLOUDFLARE_TUNNEL_TOKEN=

# ===== Almacenamiento =====
DATA_DIR=./data
SQLITE_PATH=./data/app.db
OUTPUT_DIR=./out
ASSETS_DIR=./out/assets
LOG_LEVEL=INFO

# ===== Runtime =====
POLL_INTERVAL_MINUTES=15
MAX_POSTS_PER_TICK=10
MAX_CONCURRENCY=1
REQUIRE_APPROVAL=true

TIMEOUT_SECONDS_X=20
TIMEOUT_SECONDS_DEEPSEEK=35
TIMEOUT_SECONDS_PUBLISH=60

RETRY_MAX=3
RETRY_BACKOFF_SECONDS=5

MAX_POST_CHARS=800
MAX_MODEL_OUTPUT_TOKENS=4000
